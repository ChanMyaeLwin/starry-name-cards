{
  "name": "starry-name-cards",
  "version": "0.1.0",
  "description": "Free, private, local-first business card scanner by STARRY Solutions",
  "scripts": {
    "dev": "vite",
    "setup:ocr": "node scripts/setup-ocr.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests scripts *.ts *.js *.json index.html",
    "format:check": "prettier --check src tests scripts *.ts *.js *.json index.html",
    "test:subpath": "node scripts/test-subpath.mjs"
  },
  "keywords": [
    "business-cards",
    "ocr",
    "privacy",
    "offline",
    "pwa",
    "myanmar"
  ],
  "license": "MIT",
  "dependencies": {
    "dexie": "4.4.7",
    "lucide-react": "1.61.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tesseract.js": "7.0.0"
  },
  "private": true,
  "type": "module",
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.0.4",
    "eslint": "9.39.1",
    "fake-indexeddb": "6.2.6",
    "globals": "17.13.0",
    "jsdom": "26.1.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
